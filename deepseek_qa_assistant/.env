# ===========================================================================
# DeepSeek 知识问答小助手 —— 本地配置（请勿提交到 Git / 勿分享）
# ===========================================================================

# 【必填】DeepSeek API Key
DEEPSEEK_API_KEY=(填入你自己的deep seek api)
# 【可选】API 服务地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 【可选】模型名称。
# 官方文档确认：DeepSeek-V4.1-Flash 对外模型名为 deepseek-flash
# 参考：https://api-docs.deepseek.com/zh-cn/quick_start/pricing
DEEPSEEK_MODEL=deepseek-flash

# 【可选】思考模式：true 开启（默认，更准但更慢）/ false 关闭（更快）
DEEPSEEK_THINKING=true

# 【可选】思考强度：low / high / max
DEEPSEEK_REASONING_EFFORT=high

# 【可选】采样温度：仅在思考模式关闭时生效
DEEPSEEK_TEMPERATURE=0.4

# 【可选】请求超时（秒）
DEEPSEEK_TIMEOUT=120

# 【可选】历史保留轮数
MAX_HISTORY_ROUNDS=10
