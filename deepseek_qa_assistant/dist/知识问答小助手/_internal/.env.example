# ===========================================================================
# DeepSeek 知识问答小助手 —— 环境变量示例文件
#
# 使用方式：
#   1. 把本文件复制为 .env（同一目录下）
#   2. 将下面的占位符替换为你自己的真实配置
#   3. 千万不要把真实的 .env 提交到 Git 仓库
# ===========================================================================

# 【必填】DeepSeek API Key，从 https://platform.deepseek.com/ 获取
DEEPSEEK_API_KEY=sk-在此填入你的真实APIKey

# 【可选】API 服务地址，默认 https://api.deepseek.com，一般不需要修改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 【可选】模型名称。
# 注意：截至编写时，DeepSeek 官方对「DeepSeek-V4.1-Flash」对外提供的模型名为
#       deepseek-flash（旧名 deepseek-v4-flash 已下线）。
#       请务必按官方文档核对：https://api-docs.deepseek.com/zh-cn/quick_start/pricing
DEEPSEEK_MODEL=deepseek-flash

# 【可选】思考模式开关，true / false。
# DeepSeek 思考模式默认开启；开启时模型会先输出思维链再给最终回答，
# 准确率更高但响应更慢、消耗更多输出 token。
DEEPSEEK_THINKING=true

# 【可选】思考强度，可选 low / high / max，默认 high。
# 仅在思考模式开启时生效（思考模式不支持 temperature 参数）。
DEEPSEEK_REASONING_EFFORT=high

# 【可选】采样温度，0.0 ~ 2.0。
# 仅在思考模式关闭（DEEPSEEK_THINKING=false）时才会真正生效。
DEEPSEEK_TEMPERATURE=0.4

# 【可选】单次请求超时时间（秒）
DEEPSEEK_TIMEOUT=120
