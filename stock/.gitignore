# ============================================================
#  stock · A股量化分析系统 忽略规则
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- 虚拟环境（658 MB，绝不提交）----------
.venv/
venv/
env/
ENV/

# ---------- 打包中间产物 ----------
build/
*.egg-info/
.eggs/

# 注意: dist/ 特意不忽略 —— 里面是打包好的「股票预测一键启动.exe」，
#       方便 clone 后直接双击运行。仓库根目录的 .gitignore 忽略了 dist/，
#       所以本文件用 !dist/ 把它重新包含进来。

# ---------- 编辑器 / 系统 ----------
.idea/
.vscode/
*.swp
*~
Thumbs.db
desktop.ini

# ---------- 临时 / 备份 ----------
*.bak
*.tmp
